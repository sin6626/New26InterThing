SERVER_HOST=127.0.0.1
SERVER_PORT=3001
WEB_PORT=5174

# 必须与 contest_admin 连接同一个数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=interthing

# Nuxt 浏览器端访问后端的地址
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
NUXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# MQTT Broker（新后端会自动给客户端 ID 添加 -new26，避免与旧后端冲突）
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=new26interthing
MQTT_USERNAME=
MQTT_PASSWORD=

# 智能识别接口在 apps/server/config/recognition.json 中配置，比赛现场修改后重启后端即可。
