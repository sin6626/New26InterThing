{
  "name": "new26interthing",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "dev": "pnpm --parallel --filter @new26interthing/web --filter @new26interthing/server run dev",
    "dev:web": "pnpm --filter @new26interthing/web dev",
    "dev:server": "pnpm --filter @new26interthing/server dev",
    "start:server": "pnpm --filter @new26interthing/server start",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check:env": "pnpm --filter @new26interthing/server check:env"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
