{
  "name": "@new26interthing/server",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:env": "tsx src/config/check-env.ts",
    "migrate:operation-history": "tsx src/config/migrate-operation-history.ts",
    "migrate:error-source": "tsx src/config/migrate-error-source.ts",
    "migrate:operational-metrics": "tsx src/config/migrate-operational-metrics.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@new26interthing/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mqtt": "^5.14.1",
    "mysql2": "^3.15.2",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
